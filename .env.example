# Copy to .env (or set these in your hosting dashboard). No real secrets here.
SECRET_KEY=change-me-to-a-long-random-string
# Optional. Postgres connection string. When set, the app uses Postgres;
# when unset, it uses SQLite at DATABASE_PATH. Set automatically by render.yaml.
# DATABASE_URL=postgresql://user:password@localhost:5432/pilots
# Optional. SQLite file path (only used when DATABASE_URL is unset).
# Defaults to pilots.db next to app.py.
# DATABASE_PATH=/data/pilots.db
# Optional. Defaults to 5000.
# PORT=5000
